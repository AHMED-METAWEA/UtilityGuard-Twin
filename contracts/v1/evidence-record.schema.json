{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utilityguard.invalid/contracts/v1/evidence-record.schema.json",
  "title": "Evidence record",
  "description": "Master Spec 10.1. Every displayed number has one label from the nine. INSUFFICIENT_EVIDENCE if and only if there is no value, and then a reason is given; an input is never INSUFFICIENT_EVIDENCE. CALCULATED needs a formula and at least one input. Money: any unit that looks like a currency must be written exactly as 'EGP' or 'EGP/<m3|kWh|MWh|kW|h|day|month|year>'; an amount (EGP, EGP/year, EGP/month, EGP/day) can never be labelled as simulator, model, sensor or geometry output (pitfall P-14), and a cost (kind 'cost') is CALCULATED. A currency this pattern does not recognise is caught by the evidence kernel in code, the second line of defence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "quantity",
        "cost"
      ],
      "description": "Absent means quantity."
    },
    "value": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "label": {
      "$ref": "common.schema.json#/$defs/evidence_label"
    },
    "formula": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "scenario_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "network_version": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "detector_version": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "assumption_set": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "cost_model": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{6,40}$"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "explanation_template": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[0-9]+$"
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "p10": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "p10",
        "p50",
        "p90",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "value",
    "unit",
    "label",
    "formula",
    "inputs",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "label": {
            "const": "INSUFFICIENT_EVIDENCE"
          }
        },
        "required": [
          "label"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        },
        "required": [
          "reason"
        ]
      },
      "else": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "label": {
            "const": "CALCULATED"
          }
        },
        "required": [
          "label"
        ]
      },
      "then": {
        "properties": {
          "formula": {
            "type": "string"
          },
          "inputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cost"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "label": {
            "enum": [
              "CALCULATED",
              "INSUFFICIENT_EVIDENCE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit": {
            "pattern": "^EGP(/(year|month|day))?$"
          }
        },
        "required": [
          "unit"
        ]
      },
      "then": {
        "properties": {
          "label": {
            "enum": [
              "CALCULATED",
              "ASSUMPTION",
              "OBSERVED",
              "BENCHMARK",
              "INSUFFICIENT_EVIDENCE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "[Ee][Gg][Pp]|(^|[^A-Za-z])[Ll]\\.?[Ee]\\.?([^A-Za-z]|$)|[Uu][Ss][Dd]|[Ee][Uu][Rr]|[Gg][Bb][Pp]|[Ss][Aa][Rr]|[Aa][Ee][Dd]|£|\\$|€|[Pp][Oo][Uu][Nn][Dd]"
          }
        },
        "required": [
          "unit"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "pattern": "^EGP(/(m3|kWh|MWh|kW|h|day|month|year))?$"
          }
        }
      }
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "value": {
          "$ref": "common.schema.json#/$defs/scalar"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "$ref": "common.schema.json#/$defs/evidence_label_with_value"
        },
        "ref": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "label",
        "ref"
      ],
      "additionalProperties": false
    }
  }
}
