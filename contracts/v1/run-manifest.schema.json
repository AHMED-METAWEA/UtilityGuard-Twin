{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utilityguard.invalid/contracts/v1/run-manifest.schema.json",
  "title": "Run manifest",
  "description": "Everything needed to reproduce a run (Master Spec 10.4), in the shape `ug_core.Manifest.to_dict()` produces. The configuration is a scenario configuration. Output hashes are recorded next to the manifest and are not part of its input hash.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "config": {
      "$ref": "scenario-config.schema.json"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "versions": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "libraries": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "git_commit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{6,40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unordered": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "output_hashes": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    }
  },
  "required": [
    "schema_version",
    "config",
    "seed",
    "versions",
    "libraries",
    "git_commit",
    "unordered",
    "output_hashes"
  ],
  "additionalProperties": false
}
